# Este proyecto es un sitio estático sin build: NO necesita .env para funcionar.
# Copiar a .env.local solo si se quiere cambiar el puerto del servidor de preview.

# Puerto de server.mjs (por defecto 4322). Se lee del entorno del shell.
PORT=4322

# --- Meta Pixel ---------------------------------------------------------
# El navegador no puede leer variables de entorno en un sitio estático, así
# que el Pixel ID NO va aquí: se pega en la constante META_PIXEL_ID de
# assets/js/meta-pixel.js (es un identificador público, se versiona).
# Si el sitio migra a Next.js, la variable equivalente sería:
# NEXT_PUBLIC_META_PIXEL_ID=

# --- Meta Conversions API (aún sin implementar) --------------------------
# Secreto de servidor. Requiere un backend (p. ej. Netlify Function); nunca
# debe llegar al navegador ni a Git. Configurarlo en el panel del hosting.
META_CAPI_ACCESS_TOKEN=
